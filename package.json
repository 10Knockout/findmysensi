{
  "name": "findmysensi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @findmysensi/web",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -b && npm run build --workspace @findmysensi/web",
    "clean": "npm run clean --workspaces --if-present",
    "check:boundaries": "node tools/architecture/check-boundaries.mjs",
    "decisions:check": "tsx tools/decisions/validator.ts",
    "protocol:freeze:check": "tsx tools/protocol/freeze-validator.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.5.1",
    "tsx": "4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "zod": "4.5.4"
  }
}
