# FindMySensi — Environment Variables
#
# Copy this file to .env.local and fill in the values.
# This file documents variables used by the public web app.
# No production secrets should be committed.

# ─── Development ─────────────────────────────────────────────
# Public mock API port (development only, never production)
NEXT_PUBLIC_MOCK_API_PORT=4100

# ─── Build ───────────────────────────────────────────────────
# Node environment
NODE_ENV=development
