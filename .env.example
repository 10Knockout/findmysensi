# FindMySensi public web environment
# Development defaults to http://localhost:4000 when API_URL is omitted.
# Production builds require the deployed secure API origin and HTTPS.
API_URL=

# Build-time opt-in for the ?inputDebug=1 trainer verification overlay.
# Leave unset for deployments: the overlay and its console output are then
# compiled out of the bundle. CI's browser E2E job sets it to "1".
NEXT_PUBLIC_ENABLE_INPUT_DIAGNOSTICS=
