{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@findmysensi/protocol": ["./packages/protocol/src/index.ts"],
      "@findmysensi/aim-core": ["./packages/aim-core/src/index.ts"],
      "@findmysensi/input-browser": ["./packages/input-browser/src/index.ts"],
      "@findmysensi/performance": ["./packages/performance/src/index.ts"],
      "@findmysensi/render-canvas": ["./packages/render-canvas/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  }
}
