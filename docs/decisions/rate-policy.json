{
  "status": "proposed",
  "topic": "Restricted Rate Policy and Anti-Abuse",
  "rules": {
    "login": {
      "maxAttempts": 5,
      "windowMs": 900000,
      "lockoutMs": 900000,
      "action": "lockout"
    },
    "registration": {
      "maxAttempts": 3,
      "windowMs": 3600000,
      "action": "block_ip"
    },
    "otp_request": {
      "maxAttempts": 3,
      "windowMs": 300000,
      "action": "block_email"
    },
    "password_reset": {
      "maxAttempts": 3,
      "windowMs": 3600000,
      "action": "block_email"
    }
  },
  "rationale": "Prevent brute-forcing of credentials, credential stuffing, and email enumeration/spamming by enforcing strict rate limits on authentication endpoints.",
  "approval": {
    "required": true,
    "signed_by": null,
    "timestamp": null
  }
}
